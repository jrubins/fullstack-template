{
  "name": "@app/api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "dev": "dotenvx run -q -f ../../.env --ignore=MISSING_ENV_FILE -- node --watch --watch-preserve-output src/server.ts",
    "start": "node src/server.ts",
    "test": "dotenvx run -q -f ../../.env --ignore=MISSING_ENV_FILE -- vitest run"
  },
  "dependencies": {
    "@app/db": "workspace:*",
    "@app/shared": "workspace:*",
    "@sentry/node": "11.16.0",
    "@vercel/functions": "3.11.3",
    "cors": "2.8.6",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "7.2.1",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.2",
    "vitest": "catalog:"
  }
}
