# Local development environment. Copy to .env: `cp .env.example .env`
# Loaded by dotenvx (`dotenvx run`). To commit secrets safely instead, encrypt with
# `pnpm exec dotenvx encrypt` and keep .env.keys out of git (already ignored).

# --- Database (packages/db, apps/api) ---
DATABASE_URL=postgresql://app:app@localhost:5432/app
TEST_DATABASE_URL=postgresql://app:app@localhost:5432/app_test

# --- API (apps/api) ---
PORT=3000
LOG_LEVEL=info
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173
# Sentry is disabled while the DSN is empty.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# --- Web (apps/web). Only VITE_* variables are exposed to the browser. ---
VITE_API_URL=http://localhost:3000
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=1.0
VITE_SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE=1.0
VITE_SENTRY_REPLAY_SESSION_SAMPLE_RATE=0
